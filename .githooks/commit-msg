#!/bin/sh
set -eu

message_file="$1"
first_line="$(head -n 1 "$message_file")"

# Conventional Commits. Merge/revert commits generated by Git may be handled separately.
if printf '%s\n' "$first_line" | grep -Eq '^(feat|fix|perf|refactor|test|docs|build|ci|chore|revert)(\([a-z0-9_.-]+\))?(!)?: .+'; then
  exit 0
fi

case "$first_line" in
  "Merge "*|"Revert "*) exit 0 ;;
esac

printf '%s\n' 'Invalid commit message format.' >&2
printf '%s\n' 'Expected: feat(timeline): add editable keyframes' >&2
printf '%s\n' 'Add requirement IDs in the body/PR: Refs: FR-008' >&2
exit 1
